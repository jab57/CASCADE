# =============================================================================
# CASCADE MCP Server Configuration
# =============================================================================
# Copy this file to .env and customize as needed

# =============================================================================
# SSL CONFIGURATION
# =============================================================================
# Set to '1' to disable SSL certificate verification (corporate proxy environments)
# CASCADE_SSL_NO_VERIFY=0

# =============================================================================
# LLM INSIGHTS CONFIGURATION (Optional)
# =============================================================================
# Enable LLM-powered biological insights in comprehensive_perturbation_analysis
# Set to 'true' to enable
USE_LLM_INSIGHTS=false

# LLM provider: ollama (default) | openai | openai_compatible | anthropic
LLM_PROVIDER=ollama

# -----------------------------------------------------------------------------
# Option A: Ollama Local Mode (DEFAULT - no API key needed)
# -----------------------------------------------------------------------------
# Install Ollama: https://ollama.com/download
# Pull a model: ollama pull llama3.1:8b
# Start server: ollama serve (runs on localhost:11434 by default)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# -----------------------------------------------------------------------------
# Option B: Ollama Cloud Mode
# -----------------------------------------------------------------------------
# Get API key from https://ollama.com
# OLLAMA_API_KEY=your-ollama-cloud-key-here

# -----------------------------------------------------------------------------
# Option C: OpenAI or OpenAI-compatible (Groq, Together, etc.)
# -----------------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_API_BASE=https://api.groq.com/openai/v1   # only for openai_compatible

# -----------------------------------------------------------------------------
# Option D: Anthropic
# -----------------------------------------------------------------------------
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-haiku-4-5-20251001

# -----------------------------------------------------------------------------
# LLM Performance Tuning
# -----------------------------------------------------------------------------
# Timeout for LLM calls in seconds (default: 60)
OLLAMA_TIMEOUT=60

# Temperature for LLM generation (0.0-1.0, lower = more deterministic)
OLLAMA_TEMPERATURE=0.3

# Maximum tokens for LLM response
OLLAMA_MAX_TOKENS=2000
